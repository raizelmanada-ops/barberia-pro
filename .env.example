# ==========================================================================
# BARBERIA_PRO - Environment Variables Configuration Template (.env.example)
# PRODUCTION & SANDBOX CREDENTIALS TEMPLATE
# ==========================================================================

# ==========================================================================
# 1. FRONTEND / CLIENT-SIDE VARIABLES (PUBLIC - SAFE FOR BUNDLE)
# Only variables prefixed with VITE_ are accessible in the browser.
# NEVER put private tokens, service role keys, or webhook secrets here!
# ==========================================================================

# Supabase Public Endpoint & Anon Key (Protected by PostgreSQL RLS)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Hotmart Public Product & Offer Codes (Public Checkout IDs)
VITE_HOTMART_PRODUCT_ID=PENDIENTE_DE_CONFIGURACION_EXTERNA
VITE_HOTMART_OFFER_STARTER=STA_001
VITE_HOTMART_OFFER_PRO=PRO_001
VITE_HOTMART_OFFER_ENTERPRISE=ENT_001

# Official Pilot Tenant Phone
VITE_WHATSAPP_PILOT_PHONE="+57 310 236 5163"

# Application Environment Mode ('sandbox' | 'production')
VITE_APP_ENV=sandbox

# ==========================================================================
# 2. SERVER-SIDE / EDGE FUNCTIONS / WEBHOOK SECRETS (STRICTLY PRIVATE)
# NEVER use VITE_ prefix for these variables.
# NEVER expose in frontend code, never commit real values to Git.
# ==========================================================================

# Supabase Admin / Service Role Key (Bypasses RLS - Server Only)
SUPABASE_SERVICE_ROLE_KEY=PENDIENTE_DE_CONFIGURACION_EXTERNA

# Hotmart Webhook Verification Token (HotTok - Server Only)
HOTMART_HOTTOK=PENDIENTE_DE_CONFIGURACION_EXTERNA_HOTMART

# Meta WhatsApp Cloud API Credentials (Server Only)
META_WA_PHONE_NUMBER_ID=PENDIENTE_DE_CONFIGURACION_EXTERNA_META
META_WA_WABA_ID=PENDIENTE_DE_CONFIGURACION_EXTERNA_META
META_WA_ACCESS_TOKEN=PENDIENTE_DE_CONFIGURACION_EXTERNA_META
META_WA_WEBHOOK_VERIFY_TOKEN=barberia_webhook_secret_token
